# FiftyAPI configuration. See docs/deployment.md or docs/en/deployment.md.
# Local startup (scripts/start-local.sh) loads this file as shell assignments.
# Optional host address and port. Local startup defaults to 127.0.0.1:8080;
# Docker Compose defaults to 0.0.0.0:8080. The container always uses port 8080.
# Use 0.0.0.0:8080 for LAN access, or 127.0.0.1:8080 for local access only.
# FIFTYAPI_LISTEN=127.0.0.1:8080
# Optional: leave unset or blank to use a Docker-managed named volume.
# To use a host directory mounted at /data, uncomment the following line.
# Relative paths are based on compose.yaml; absolute paths are also supported.
# FIFTYAPI_DATA_PATH=./data
# Optional: leave blank to generate and persist master.key beside the database.
# Never use a shared default such as "fiftyapi". Back up the generated file.
# To supply your own: openssl rand -base64 32.
FIFTYAPI_MASTER_KEY=
# Optional: leave blank to generate setup-token beside the database on first setup.
# Docker: docker compose exec fiftyapi cat /data/setup-token
# To supply your own: openssl rand -hex 4.
FIFTYAPI_SETUP_TOKEN=
FIFTYAPI_COOKIE_SECURE=false
TZ=Asia/Shanghai
# Build from source: keep fiftyapi:local and run docker compose up -d --build.
# Use the published image: set dyunwei/fiftyapi, then docker compose pull && docker compose up -d --no-build.
FIFTYAPI_IMAGE=fiftyapi:local
# Optional Antigravity OAuth client parameter override; unset or blank uses
# the built-in value. Normal authorization and account import need no override.
# Must match the OAuth client_id; do not use an arbitrary value.
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional email fallback; System Settings can override these values immediately.
# Changes to environment variables themselves require a restart.
# HTTP and HTTPS site origins are supported, including LAN IPs and hostnames.
# Example: http://192.168.1.10:8080 (set COOKIE_SECURE=false for HTTP).
FIFTYAPI_PUBLIC_URL=
FIFTYAPI_SMTP_HOST=
FIFTYAPI_SMTP_PORT=587
FIFTYAPI_SMTP_FROM=
FIFTYAPI_SMTP_USERNAME=
FIFTYAPI_SMTP_PASSWORD=
# starttls (usually 587) or tls (usually 465); none is loopback-only for tests.
FIFTYAPI_SMTP_TLS=starttls
